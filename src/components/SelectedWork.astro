---
import { Image } from 'astro:assets';
import { typeLabel, type ProjectWithImages } from '../data/projects';
import { site } from '../data/site';

interface Props {
  projects: ProjectWithImages[];
}

const { projects } = Astro.props;
const caption = (p: ProjectWithImages) => `${p.data.title} · ${typeLabel(p)} · ${p.data.year}`;
---

<section class="container selected" aria-labelledby="selected-heading" data-index>
  <div class="head" data-reveal>
    <h2 id="selected-heading" class="label">
      Selected work
    </h2>
    <a class="cta" href="/projects/">
      View all projects &rarr;
    </a>
  </div>

  <div class="layout">
    <ul class="list" role="list">
      {projects.map((p, i) => (
        <li data-reveal>
          <button
            class:list={['row', { 'is-active': i === 0 }]}
            type="button"
            aria-haspopup="dialog"
            data-open-project={p.id}
            data-row={i}
            data-caption={caption(p)}
          >
            <span>{p.data.code}</span>
            <span class="name">{p.data.title}</span>
            <span class="hide-sm">{typeLabel(p)}</span>
            <span class="year">{p.data.year}</span>
          </button>
        </li>
      ))}
    </ul>

    <div class="preview" aria-hidden="true" data-reveal>
      <div class="frame">
        {projects.map(
          (p, i) =>
            p.cover && (
              <Image
                src={p.cover}
                alt=""
                widths={[440, 880]}
                sizes="(min-width: 900px) 440px, 100vw"
                class:list={['shot', { 'is-active': i === 0 }]}
                data-shot={i}
              />
            ),
        )}
        {site.showPlaceholderLabels && (
          <span class="ph-label" data-preview-code>
            Preview &middot; {projects[0]?.data.code}
          </span>
        )}
      </div>
      <p class="caption" data-preview-caption>
        {projects[0] && caption(projects[0])}
      </p>
    </div>
  </div>
</section>

<script>
  import '../scripts/index-preview';
</script>

<style>
  .selected {
    padding-top: 96px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 24px;
  }

  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-start;
  }

  .list {
    flex: 999 1 560px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) 150px 56px;
    column-gap: 16px;
    align-items: baseline;
    width: 100%;
    margin: 0;
    padding: 18px 0;
    background: transparent;
    border: 0;
    border-top: 1px solid var(--line);
    color: var(--muted-row);
    font-size: 1rem;
    line-height: 1.5;
    text-align: left;
    cursor: pointer;
    transition:
      padding-left 0.25s ease,
      background-color 0.25s ease;
  }

  .row.is-active {
    color: var(--ink);
  }

  .row:focus-visible {
    padding-left: 16px;
    background-color: rgba(43, 42, 122, 0.05);
  }

  /* Instant press feedback, on pointer-down. */
  .row:active {
    background-color: rgba(43, 42, 122, 0.08);
    transition-duration: 0s;
  }

  .name {
    font-weight: 600;
  }

  .row:focus-visible .name {
    text-decoration: underline;
    text-decoration-color: var(--teal);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  @media (hover: hover) {
    .row:hover {
      padding-left: 16px;
      background-color: rgba(43, 42, 122, 0.05);
    }

    .row:hover .name {
      text-decoration: underline;
      text-decoration-color: var(--teal);
      text-decoration-thickness: 2px;
      text-underline-offset: 6px;
    }
  }

  .year {
    text-align: right;
  }

  .preview {
    flex: 1 1 320px;
    min-width: 0;
    max-width: 440px;
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .frame {
    aspect-ratio: 4 / 5;
  }

  .frame :global(.shot) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }

  .frame :global(.shot.is-active) {
    opacity: 1;
  }

  .caption {
    margin-top: 14px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* The preview follows the hovered row, which touch screens can't do, so
     there it would only ever show the first project. */
  @media (hover: none) {
    .preview {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .row {
      grid-template-columns: 56px minmax(0, 1fr) 48px;
    }

    .hide-sm {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row {
      transition: none;
    }
  }
</style>
