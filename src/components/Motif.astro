---
interface Props {
  stroke?: string;
  opacity?: number;
  class?: string;
}

const { stroke = '#2B2A7A', opacity = 0.28, class: className } = Astro.props;

const rects = Array.from({ length: 16 }, (_, i) => {
  const size = 520 - 28 * i;
  const xy = 300 - size / 2;
  return { xy, size, rx: Math.round(size * 0.28), rotate: 5 * i };
});
---

<div class:list={['motif-wrap', className]} aria-hidden="true">
  <svg
    class="motif"
    viewBox="0 0 600 600"
    width="100%"
    height="100%"
    fill="none"
    stroke={stroke}
    stroke-opacity={opacity}
    stroke-width="1"
    aria-hidden="true"
    focusable="false"
  >
    {rects.map((r) => (
      <rect
        x={r.xy}
        y={r.xy}
        width={r.size}
        height={r.size}
        rx={r.rx}
        transform={`rotate(${r.rotate} 300 300)`}
      />
    ))}
  </svg>
</div>

<style>
  .motif-wrap {
    position: absolute;
    pointer-events: none;
  }

  .motif {
    display: block;
    transform-origin: 50% 50%;
    animation: spin 160s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .motif {
      animation: none;
    }
  }

  @media (max-width: 700px) {
    .motif-wrap {
      width: 320px !important;
      height: 320px !important;
      right: -140px !important;
    }
  }
</style>
