---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Motif from '../components/Motif.astro';
import ProjectViewer from '../components/ProjectViewer.astro';
import SelectedWork from '../components/SelectedWork.astro';
import { getProjects } from '../data/projects';
import { formatAddress, site } from '../data/site';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const hero = featured[0] ?? projects[0];
const { intro, contact, about, services, expertise } = site;

const marqueeText = `${site.marquee.join('\u00a0 / \u00a0')}\u00a0 /`;

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.legalName,
  alternateName: site.name,
  description: site.description,
  url: new URL('/', Astro.site).href,
  logo: new URL('/favicon.svg', Astro.site).href,
  image: new URL('/og-default.png', Astro.site).href,
  email: contact.email,
  telephone: contact.phone.tel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${contact.address.street}, ${contact.address.locality}`,
    postalCode: contact.address.postalCode,
    addressLocality: contact.address.city,
    addressCountry: contact.address.country,
  },
};
---

<BaseLayout jsonLd={jsonLd}>
  <div class="intro-wrap">
    <Motif class="intro-motif" />
    <section class="container intro">
      <h1>
        {intro.headline.before}
        <span class="highlight">{intro.headline.highlight}</span>
        {intro.headline.after}
      </h1>
      <p class="intro-sub">{intro.supporting}</p>
      <a class="intro-cta" href={intro.cta.href}>
        {intro.cta.label} &rarr;
      </a>
      <ul class="intro-meta" role="list">
        <li>&copy; {site.year}</li>
        {intro.meta.map((d) => (
          <li>{d}</li>
        ))}
      </ul>
    </section>
  </div>

  {hero && (
    <section class="container" aria-label="Featured project">
      <button class="frame hero" type="button" aria-haspopup="dialog" data-open-project={hero.id}>
        <span class="visually-hidden">
          View project {hero.data.code}, {hero.data.title}
        </span>
        {hero.cover && (
          <Image
            src={hero.cover}
            alt=""
            widths={[640, 960, 1360, 1920, 2400]}
            sizes="(min-width: 1440px) 1360px, (min-width: 701px) calc(100vw - 80px), calc(100vw - 48px)"
            loading="eager"
            fetchpriority="high"
          />
        )}
        <span class="tag hero-tag" aria-hidden="true">
          View project &rarr;
        </span>
        {site.showPlaceholderLabels && (
          <span class="ph-label hero-label" aria-hidden="true">
            Hero image placeholder &middot; {hero.data.code} {hero.data.title}
          </span>
        )}
      </button>
    </section>
  )}

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="marquee-group">
          {[0, 1, 2, 3].map(() => (
            <span>{marqueeText}</span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <SelectedWork projects={featured} />

  <section id="about" class="container block" aria-labelledby="about-heading">
    <div class="split">
      <h2 id="about-heading" class="label" data-reveal>
        About
      </h2>
      <div class="split-body">
        <p class="statement" data-reveal>
          {about.statement}
        </p>
        <p class="muted story" data-reveal>
          {about.story}
        </p>
        <ul class="pills" role="list" aria-label="Working with us" data-reveal>
          {about.workingWithUs.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <dl class="facts about-facts" data-reveal>
          {about.facts.map((f) => (
            <div>
              <dt class="meta-label">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section id="services" class="container block" aria-labelledby="services-heading">
    <div class="split">
      <h2 id="services-heading" class="label" data-reveal>
        Services
      </h2>
      <div class="split-body">
        <p class="statement services-statement" data-reveal>
          {services.statement}
        </p>
        <div class="services">
          <ul class="services-list" role="list">
            {services.items.map((s) => (
              <li class="service" data-reveal>
                <span class="service-num">{s.number}</span>
                <h3 class="service-title">{s.title}</h3>
                <p class="service-desc">
                  {s.description}
                  <span class="service-includes">{s.includes.join(' · ')}</span>
                </p>
              </li>
            ))}
          </ul>
          <p class="service-note" data-reveal>
            {services.note}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="expertise" class="expertise" aria-labelledby="expertise-heading">
    <div class="container expertise-inner">
      <div class="split">
        <h2 id="expertise-heading" class="label" data-reveal>
          Expertise
        </h2>
        <div class="split-body">
          <p class="statement" data-reveal>
            {expertise.statement}
          </p>
          <ul class="expertise-grid" role="list">
            {expertise.items.map((item) => (
              <li class="expertise-item" data-reveal>
                <h3>{item.title}</h3>
                <p class="muted">{item.description}</p>
              </li>
            ))}
          </ul>
          <div class="recognition" data-reveal>
            <span class="muted recognition-label">{expertise.credentialsLabel}</span>
            <span class="recognition-body">{expertise.credentials}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="navy-block on-navy contact" aria-labelledby="contact-heading">
    <Motif class="contact-motif" stroke="#FFFFFF" opacity={0.18} />
    <div class="container contact-inner">
      <h2 id="contact-heading" class="label contact-label" data-reveal>
        Contact
      </h2>
      <p class="contact-lead" data-reveal>
        {contact.lead}
      </p>
      <a class="cta-inv email" href={`mailto:${contact.email}`} data-reveal>
        {contact.email}
      </a>
      <div class="contact-cols" data-reveal>
        <div>
          <h3 class="contact-key">Studio</h3>
          <address>{formatAddress(contact.address)}</address>
        </div>
        <div>
          <h3 class="contact-key">Phone</h3>
          <a class="cta-inv" href={`tel:${contact.phone.tel}`}>
            {contact.phone.display}
          </a>
        </div>
        <div>
          <h3 class="contact-key">{contact.consultation.label}</h3>
          <p>{contact.consultation.value}</p>
        </div>
      </div>
    </div>
  </section>

  <ProjectViewer projects={projects} />

  <Footer slot="footer" variant="navy" />
</BaseLayout>

<script>
  import '../scripts/reveal';
</script>

<style>
  .intro-wrap {
    position: relative;
    overflow: hidden;
  }

  .intro-wrap :global(.intro-motif) {
    right: -60px;
    top: -40px;
    width: 560px;
    height: 560px;
  }

  .intro {
    position: relative;
    padding-top: 72px;
    padding-bottom: 56px;
  }

  h1 {
    max-width: 1040px;
    font-size: clamp(2.25rem, 5.6vw, 5rem);
    line-height: 1.06;
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .highlight {
    color: var(--navy);
    text-decoration: underline;
    text-decoration-color: var(--teal);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
  }

  .intro-sub {
    margin-top: 28px;
    max-width: 560px;
    font-size: 1.125rem;
    color: var(--muted);
  }

  .intro-cta {
    display: inline-block;
    margin-top: 32px;
    padding: 14px 22px;
    background: var(--navy);
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 600;
    transition:
      background-color 0.2s ease,
      transform 0.15s ease-out;
  }

  @media (hover: hover) {
    .intro-cta:hover {
      background: var(--ink);
    }
  }

  .intro-cta:active {
    transform: scale(0.97);
    transition-duration: 0.08s;
  }

  .intro-meta {
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 64px;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    cursor: pointer;
    height: clamp(320px, 52vw, 760px);
    transition: transform 0.15s ease-out;
  }

  .hero:active {
    transform: scale(0.99);
    transition-duration: 0.08s;
  }

  .hero-label {
    left: 24px;
    bottom: 20px;
  }

  .hero-tag {
    position: absolute;
    right: 24px;
    bottom: 20px;
    padding: 8px 14px;
    background: var(--navy);
    color: #ffffff;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .hero:focus-visible .hero-tag {
    opacity: 1;
    transform: none;
  }

  /* Mouse: reveal on hover. Touch: always visible so the image reads as tappable. */
  @media (hover: hover) {
    .hero:hover .hero-tag {
      opacity: 1;
      transform: none;
    }
  }

  @media (hover: none) {
    .hero-tag {
      opacity: 1;
      transform: none;
    }
  }

  .marquee {
    margin-top: 80px;
    padding: 18px 0;
    overflow: hidden;
    background: var(--navy);
    color: #ffffff;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .marquee-group {
    display: flex;
    flex: none;
  }

  .marquee-group span {
    padding-right: 40px;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }

    .hero,
    .hero-tag {
      transition: none;
    }
  }

  .block {
    padding-top: 112px;
  }

  .story {
    margin-top: 28px;
    max-width: 620px;
  }

  .pills {
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pills li {
    padding: 8px 16px;
    border: 1px solid var(--line);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .about-facts {
    margin: 56px 0 0;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 24px;
  }

  .services-statement {
    margin-bottom: 56px;
  }

  .services {
    border-bottom: 1px solid var(--line);
  }

  .services-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-note {
    padding: 20px 0;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .service {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }

  .service-num {
    flex: 0 0 48px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .service-title {
    flex: 1 1 200px;
    font-size: inherit;
    font-weight: 600;
  }

  .service-desc {
    flex: 2 1 280px;
    color: var(--muted);
  }

  .service-includes {
    display: block;
    margin-top: 6px;
    font-size: 0.8125rem;
  }

  .expertise {
    margin-top: 112px;
    background: var(--surface);
  }

  .expertise-inner {
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .expertise-grid {
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px 32px;
  }

  .expertise-item {
    padding-top: 20px;
    border-top: 1px solid var(--line-strong);
  }

  .expertise-item h3 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.5;
  }

  .expertise-item p {
    margin-top: 8px;
  }

  .recognition {
    margin-top: 72px;
    padding-top: 24px;
    border-top: 1px solid var(--line-strong);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    font-size: 0.875rem;
  }

  .recognition-label {
    flex: 0 0 160px;
  }

  .recognition-body {
    flex: 1 1 280px;
  }

  .contact-lead {
    margin-bottom: 32px;
    max-width: 600px;
    font-size: clamp(1.375rem, 2.6vw, 2.125rem);
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .contact :global(.contact-motif) {
    right: -100px;
    bottom: -200px;
    width: 640px;
    height: 640px;
  }

  .contact-inner {
    position: relative;
    padding-top: 120px;
  }

  .contact-label {
    margin-bottom: 24px;
  }

  .email {
    display: inline-block;
    max-width: 100%;
    font-size: clamp(1.75rem, 6vw, 5.5rem);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .contact-cols {
    margin-top: 72px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px 64px;
    font-size: 0.875rem;
  }

  .contact-cols > div {
    flex: 1 1 200px;
  }

  .contact-key {
    font-size: inherit;
    font-weight: 400;
    color: var(--on-navy-muted);
  }

  .contact-cols address,
  .contact-cols p,
  .contact-cols a {
    display: block;
    margin-top: 6px;
    font-style: normal;
  }
</style>
