---
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/logo-mark.png';
import portrait from '../assets/team/zulbakri.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Motif from '../components/Motif.astro';
import ProjectViewer from '../components/ProjectViewer.astro';
import SelectedWork from '../components/SelectedWork.astro';
import { getProjects } from '../data/projects';
import { formatAddress, site } from '../data/site';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const { intro, contact, about, philosophy, services, approach } = site;

const marqueeText = `${site.marquee.join('\u00a0 / \u00a0')}\u00a0 /`;

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.legalName,
  alternateName: site.name,
  description: site.description,
  url: new URL('/', Astro.site).href,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  image: new URL('/og-default.png', Astro.site).href,
  email: contact.email,
  telephone: contact.phone.tel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${contact.address.street}, ${contact.address.locality}`,
    postalCode: contact.address.postalCode,
    addressLocality: contact.address.city,
    addressCountry: contact.address.country,
  },
};
---

<BaseLayout jsonLd={jsonLd}>
  <section id="about" class="container intro" aria-labelledby="about-heading">
    <div class="intro-text">
      <h1 id="about-heading">
        {intro.headline.before}
        <span class="highlight">{intro.headline.highlight}</span>
        {intro.headline.after}
      </h1>
      <p class="intro-sub">{about.statement}</p>
      <p class="intro-story">{about.story}</p>
      <a class="intro-cta" href={intro.cta.href}>
        {intro.cta.label} &rarr;
      </a>
      <dl class="facts intro-facts">
        {about.facts.map((f) => (
          <div>
            <dt class="meta-label">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="intro-mark">
      <Image
        src={logoMark}
        alt=""
        widths={[320, 480, 640]}
        sizes="(min-width: 901px) 36vw, 70vw"
        loading="eager"
      />
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="marquee-group">
          {[0, 1, 2, 3].map(() => (
            <span>{marqueeText}</span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <section id="philosophy" class="philosophy" aria-labelledby="philosophy-heading">
    <div class="container philosophy-inner">
      <div class="philosophy-body">
        <h2 id="philosophy-heading" class="label" data-reveal>
          Our philosophy
        </h2>
        <p class="statement" data-reveal>
          {philosophy.statement}
        </p>
        <p class="philosophy-text" data-reveal>
          {philosophy.body}
        </p>
        <p class="philosophy-sign" data-reveal>
          <span class="philosophy-name">{philosophy.designer.name}</span>
          <span class="muted">{philosophy.designer.role}</span>
        </p>
      </div>
      <figure class="portrait" data-reveal>
        <Image
          src={portrait}
          alt={`${philosophy.designer.name}, ${philosophy.designer.role} of ZB Design`}
          widths={[460, 640]}
          sizes="(max-width: 900px) min(90vw, 380px), 460px"
        />
      </figure>
    </div>
  </section>

  <SelectedWork projects={featured} />

  <section id="services" class="container block" aria-labelledby="services-heading">
    <div class="split">
      <h2 id="services-heading" class="label" data-reveal>
        Services
      </h2>
      <div class="split-body">
        <p class="statement services-statement" data-reveal>
          {services.statement}
        </p>
        <div class="services">
          <ul class="services-list" role="list">
            {services.items.map((s) => (
              <li class="service" data-reveal>
                <span class="service-num">{s.number}</span>
                <h3 class="service-title">{s.title}</h3>
                <p class="service-desc">{s.description}</p>
              </li>
            ))}
          </ul>
          <p class="service-note" data-reveal>
            {services.note}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="approach" class="approach" aria-labelledby="approach-heading">
    <div class="container approach-inner">
      <div class="split">
        <h2 id="approach-heading" class="label" data-reveal>
          Approach
        </h2>
        <div class="split-body">
          <p class="statement" data-reveal>
            {approach.statement}
          </p>
          <ul class="approach-grid" role="list">
            {approach.items.map((item) => (
              <li class="approach-item" data-reveal>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </li>
            ))}
          </ul>
          <div class="recognition" data-reveal>
            <span class="muted recognition-label">{approach.credentialsLabel}</span>
            <span class="recognition-body">{approach.credentials}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="navy-block on-navy contact" aria-labelledby="contact-heading">
    <Motif class="contact-motif" stroke="#FFFFFF" opacity={0.18} />
    <div class="container contact-inner">
      <h2 id="contact-heading" class="label contact-label" data-reveal>
        Contact
      </h2>
      <p class="contact-lead" data-reveal>
        {contact.lead}
      </p>
      <a class="cta-inv email" href={`mailto:${contact.email}`} data-reveal>
        {contact.email}
      </a>
      <div class="contact-cols" data-reveal>
        <div>
          <h3 class="contact-key">Studio</h3>
          <address>{formatAddress(contact.address)}</address>
        </div>
        <div>
          <h3 class="contact-key">Phone</h3>
          <a class="cta-inv" href={`tel:${contact.phone.tel}`}>
            {contact.phone.display}
          </a>
        </div>
        <div>
          <h3 class="contact-key">{contact.consultation.label}</h3>
          <p>{contact.consultation.value}</p>
        </div>
      </div>
    </div>
  </section>

  <ProjectViewer projects={projects} />

  <Footer slot="footer" variant="navy" />
</BaseLayout>

<script>
  import '../scripts/reveal';
</script>

<style>
  .intro {
    padding-top: 72px;
    padding-bottom: 104px;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px 80px;
    align-items: center;
  }

  .intro-mark img {
    width: 100%;
    max-width: 520px;
    margin-left: auto;
  }

  /* The mark settles in as the page opens. */
  @media (prefers-reduced-motion: no-preference) {
    .intro-mark img {
      animation: mark-settle 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
  }

  @keyframes mark-settle {
    from {
      opacity: 0;
      transform: rotate(-8deg) scale(0.9);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .intro-story {
    margin-top: 16px;
    max-width: 560px;
  }

  .intro-facts {
    margin: 56px 0 0;
    max-width: 640px;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 24px;
  }

  @media (max-width: 900px) {
    .intro {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 48px;
      padding-bottom: 80px;
    }

    .intro-mark {
      order: -1;
    }

    .intro-mark img {
      max-width: 160px;
      margin-left: 0;
    }
  }

  h1 {
    max-width: 1040px;
    font-size: clamp(2.25rem, 5.6vw, 5rem);
    line-height: 1.06;
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .highlight {
    color: var(--navy);
    text-decoration: underline;
    text-decoration-color: var(--teal);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
  }

  .intro-sub {
    margin-top: 28px;
    max-width: 560px;
    font-size: 1.25rem;
    line-height: 1.45;
  }

  .intro-cta {
    display: inline-block;
    margin-top: 32px;
    padding: 14px 22px;
    background: var(--navy);
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 600;
    transition:
      background-color 0.2s ease,
      transform 0.15s ease-out;
  }

  @media (hover: hover) {
    .intro-cta:hover {
      background: var(--ink);
    }
  }

  .intro-cta:active {
    transform: scale(0.97);
    transition-duration: 0.08s;
  }

  .marquee {
    padding: 18px 0;
    overflow: hidden;
    background: var(--navy);
    color: #ffffff;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .marquee-group {
    display: flex;
    flex: none;
  }

  .marquee-group span {
    padding-right: 40px;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  .block {
    padding-top: 112px;
  }

  .services-statement {
    margin-bottom: 56px;
  }

  .services {
    border-bottom: 1px solid var(--line);
  }

  .services-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-note {
    padding: 20px 0;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .service {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }

  .service-num {
    flex: 0 0 48px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .service-title {
    flex: 1 1 200px;
    font-size: inherit;
    font-weight: 600;
  }

  .service-desc {
    flex: 2 1 280px;
    color: var(--muted);
  }

  .approach {
    margin-top: 112px;
    background: var(--surface);
  }

  .approach-inner {
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .approach-grid {
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 48px;
  }

  @media (max-width: 1100px) {
    .approach-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .approach-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .approach-item h3 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .approach-item p {
    margin-top: 12px;
    max-width: 44ch;
    font-size: 1rem;
    line-height: 1.55;
  }

  .philosophy {
    background: #e8e9eb; /* the portrait's own backdrop, so its edges disappear */
  }

  /* The portrait takes the left column, beside the words.
     Source order stays text first for reading. */
  .philosophy-inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas: 'portrait body';
    gap: 48px 96px;
    align-items: end;
  }

  .philosophy-body {
    grid-area: body;
  }

  .philosophy-body {
    padding: 120px 0;
  }

  .philosophy-body .label {
    margin-bottom: 32px;
  }

  .philosophy-text {
    margin-top: 24px;
    max-width: 600px;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .philosophy-sign {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .philosophy-name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* The portrait stands on the bottom edge of the field. */
  .portrait {
    grid-area: portrait;
    margin: 0;
    justify-self: end;
    width: min(100%, 460px);
  }

  .portrait img {
    width: 100%;
  }

  @media (max-width: 900px) {
    .philosophy-inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'body' 'portrait';
      gap: 0;
    }

    .philosophy-body {
      padding: 96px 0 48px;
    }

    .portrait {
      justify-self: center;
      width: min(90%, 380px);
    }
  }

  .recognition {
    margin-top: 72px;
    padding-top: 24px;
    border-top: 1px solid var(--line-strong);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    font-size: 0.875rem;
  }

  .recognition-label {
    flex: 0 0 160px;
  }

  .recognition-body {
    flex: 1 1 280px;
  }

  .contact-lead {
    margin-bottom: 32px;
    max-width: 600px;
    font-size: clamp(1.375rem, 2.6vw, 2.125rem);
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .contact :global(.contact-motif) {
    right: -100px;
    bottom: -200px;
    width: 640px;
    height: 640px;
  }

  .contact-inner {
    position: relative;
    padding-top: 120px;
  }

  .contact-label {
    margin-bottom: 24px;
  }

  .email {
    display: inline-block;
    max-width: 100%;
    font-size: clamp(1.75rem, 6vw, 5.5rem);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .contact-cols {
    margin-top: 72px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px 64px;
    font-size: 0.875rem;
  }

  .contact-cols > div {
    flex: 1 1 200px;
  }

  .contact-key {
    font-size: inherit;
    font-weight: 400;
    color: var(--on-navy-muted);
  }

  .contact-cols address,
  .contact-cols p,
  .contact-cols a {
    display: block;
    margin-top: 6px;
    font-style: normal;
  }
</style>
