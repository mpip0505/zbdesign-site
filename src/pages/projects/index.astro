---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Motif from '../../components/Motif.astro';
import ProjectShowcase from '../../components/ProjectShowcase.astro';
import ProjectViewer from '../../components/ProjectViewer.astro';
import { getProjects } from '../../data/projects';
import { site } from '../../data/site';

// Featured projects only; the showcase shows the first seven.
const projects = (await getProjects()).filter((p) => p.data.featured);
const page = site.projectsPage;
---

<BaseLayout title={page.title} description={page.description}>
  <div class="intro-wrap">
    <Motif class="projects-motif" />
    <section class="container intro">
      <h1 class="page-title">
        {page.title}
        <span class="dot" aria-hidden="true">
          .
        </span>
      </h1>
      <p class="muted lead">{page.intro}</p>
    </section>
  </div>

  <ProjectShowcase projects={projects} />

  <ProjectViewer projects={projects} />

  <Footer slot="footer" variant="light" />
</BaseLayout>

<style>
  .intro-wrap {
    position: relative;
    overflow: hidden;
  }

  .intro-wrap :global(.projects-motif) {
    right: -60px;
    top: -80px;
    width: 520px;
    height: 520px;
  }

  .intro {
    position: relative;
    padding-top: 72px;
    padding-bottom: 48px;
  }

  .lead {
    margin-top: 24px;
    max-width: 520px;
  }
</style>
